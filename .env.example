APP_PORT=8080

# ── PostgreSQL (Supabase) ───────────────────────────────────────────────
# Obtén estos valores en: Supabase → Project Settings → Database → Connection string
# Recomendado usar el "Connection pooler" (puerto 6543) en producción para
# evitar agotar conexiones; para desarrollo local también funciona el 5432.
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=CambiarEstaClave123!
DB_NAME=postgres

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# ALLOWED_DOMAIN ya NO restringe el login: la organización se resuelve
# dinámicamente por el dominio del correo contra la tabla `organizaciones`
# (así un mismo backend sirve a varias Alcaldías). Se deja como referencia
# informativa opcional, no es obligatoria.
ALLOWED_DOMAIN=

# Cuenta de servicio para Google Drive (sin domain-wide delegation).
# Debe ser miembro directo de una Unidad Compartida — compártela con el
# client_email de este JSON dándole rol "Administrador de contenido".
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/sigpa-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GMAIL_IMPERSONATE_EMAIL y GOOGLE_DRIVE_IMPERSONATE_EMAIL quedan sin uso
# mientras no haya domain-wide delegation activada (requiere admin.google.com).

JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Envío de correo de alertas vía SMTP (cuenta Gmail institucional normal +
# contraseña de aplicación — NO la contraseña normal de la cuenta).
# Generar en: myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@alcaldiadefunza.gov.co
SMTP_APP_PASSWORD=

ALERTAS_CRON_SPEC=0 6 * * *

CORS_ALLOWED_ORIGINS=http://localhost:3000
